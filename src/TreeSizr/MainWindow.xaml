<Window x:Class="TreeSizr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TreeSizr"
        xmlns:vm="clr-namespace:TreeSizr.ViewModels"
        xmlns:controls="clr-namespace:TreeSizr.Controls"
        Title="{Binding WindowTitle}" Icon="Assets/TreeSizr.ico" Width="1150" Height="720" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12.5"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Fg.Text}"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        Closing="Window_Closing">

    <Window.Resources>
        <local:TreeRowWidthConverter x:Key="RowWidth" />
        <local:PercentToStarConverter x:Key="PercentStar" />
        <local:BoolToColumnWidthConverter x:Key="ColumnWidth" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:FileIconConverter x:Key="FileIcon" />
        <local:BytesConverter x:Key="Bytes" />

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg.Header}" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Size bar behind folder names; the style follows the NameBar setting. -->
        <Style x:Key="NameBarFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource NameBar.Gradient}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NameBar, Source={x:Static local:AppSettings.Current}}"
                             Value="{x:Static local:NameBarStyle.Solid}">
                    <Setter Property="Background" Value="{DynamicResource NameBar.Solid}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NameBar, Source={x:Static local:AppSettings.Current}}"
                             Value="{x:Static local:NameBarStyle.Off}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="FolderMenu" x:Shared="False">
            <MenuItem Header="{local:Tr OpenInExplorer}" Click="OpenFolder_Click" />
            <MenuItem Header="{local:Tr CopyPath}" Click="CopyFolderPath_Click" />
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="{local:Tr Drive}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox DockPanel.Dock="Left" Width="70" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                          IsEnabled="{Binding IsIdle}" />
                <TextBlock DockPanel.Dock="Left" Text="{local:Tr Folder}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" MinWidth="0" Padding="8,3"
                        ToolTip="{local:Tr Settings}" Click="Settings_Click">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
                <Button DockPanel.Dock="Right" Content="{local:Tr Cancel}" Style="{StaticResource ToolButton}"
                        Command="{Binding CancelCommand}" />
                <Button DockPanel.Dock="Right" Content="{local:Tr Scan}" Style="{StaticResource ToolButton}"
                        IsDefault="True" FontWeight="SemiBold" Command="{Binding ScanCommand}" />
                <Button DockPanel.Dock="Right" Content="{local:Tr FastScanAdmin}" Style="{StaticResource ToolButton}"
                        ToolTip="{local:Tr FastScanAdminTip}" Click="Elevate_Click"
                        Visibility="{Binding CanElevate, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Content="{local:Tr Browse}" Style="{StaticResource ToolButton}"
                        Click="Browse_Click" IsEnabled="{Binding IsIdle}" />
                <TextBox x:Name="PathBox" VerticalContentAlignment="Center" Padding="4,2" IsEnabled="{Binding IsIdle}"
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Padding="4,0">
            <StatusBarItem>
                <ProgressBar Width="140" Height="12" IsIndeterminate="{Binding IsScanning}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="6">
            <!-- Folder tree -->
            <TabItem Header="{local:Tr TabFolders}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Column headers; right margin matches TreeRowWidthConverter so columns line up. -->
                    <Grid Margin="20,4,24,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="{Binding ShowAllocatedColumn, Source={x:Static local:AppSettings.Current}, Converter={StaticResource ColumnWidth}, ConverterParameter=90}" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="{Binding ShowShareColumn, Source={x:Static local:AppSettings.Current}, Converter={StaticResource ColumnWidth}, ConverterParameter=116}" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Tr ColFolder}" Style="{StaticResource ColumnHeader}" Margin="22,0,0,0" />
                        <TextBlock Grid.Column="1" Text="{local:Tr ColSize}" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{local:Tr ColAllocated}" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right"
                                   ToolTip="{local:Tr ColAllocatedTip}"
                                   Visibility="{Binding ShowAllocatedColumn, Source={x:Static local:AppSettings.Current}, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="3" Text="{local:Tr ColPercent}" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{local:Tr ColShare}" Style="{StaticResource ColumnHeader}" Margin="10,0"
                                   Visibility="{Binding ShowShareColumn, Source={x:Static local:AppSettings.Current}, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="5" Text="{local:Tr ColFiles}" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                    </Grid>

                    <TreeView x:Name="Tree" Grid.Row="1" BorderThickness="0,1,0,0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                              ItemsSource="{Binding TreeRoots}"
                              ContextMenu="{StaticResource FolderMenu}"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                <Setter Property="Padding" Value="1,2" />
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}" ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.Width>
                                        <MultiBinding Converter="{StaticResource RowWidth}">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=TreeView}" />
                                            <Binding Path="Depth" />
                                        </MultiBinding>
                                    </Grid.Width>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="{Binding ShowAllocatedColumn, Source={x:Static local:AppSettings.Current}, Converter={StaticResource ColumnWidth}, ConverterParameter=90}" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="{Binding ShowShareColumn, Source={x:Static local:AppSettings.Current}, Converter={StaticResource ColumnWidth}, ConverterParameter=116}" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Name with a bar behind it sized to the share of the parent folder. -->
                                    <Grid Margin="0,0,8,0">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentStar}}" />
                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentStar}, ConverterParameter=rest}" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Bar" Style="{StaticResource NameBarFill}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="3,0,0,0">
                                            <!-- Windows shell icon; a red lock glyph replaces it for folders without access. -->
                                            <Image x:Name="FileIcon" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Source="{x:Static local:FileIcons.Folder}" />
                                            <TextBlock x:Name="Icon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Fg.Error}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                            <TextBlock Text="{Binding MeasuredSizeText}" Width="64" TextAlignment="Right" Margin="0,0,10,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding ShowSizeInName, Source={x:Static local:AppSettings.Current}, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock x:Name="GroupText" Visibility="Collapsed" VerticalAlignment="Center">
                                                <Run Text="[" /><Run Text="{Binding FilesText, Mode=OneWay}" />
                                                <Run Text="{local:Tr FilesGroup}" /><Run Text="]" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" Margin="4,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding AllocatedText}" HorizontalAlignment="Right" Margin="4,0" Foreground="{DynamicResource Fg.Muted}"
                                               Visibility="{Binding ShowAllocatedColumn, Source={x:Static local:AppSettings.Current}, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" HorizontalAlignment="Right" Margin="4,0" />
                                    <Border Grid.Column="4" Width="102" Height="11" Margin="10,0,4,0" HorizontalAlignment="Left"
                                            BorderBrush="{DynamicResource Share.Border}" BorderThickness="1" Background="{DynamicResource Share.Track}"
                                            Visibility="{Binding ShowShareColumn, Source={x:Static local:AppSettings.Current}, Converter={StaticResource BoolToVisibility}}">
                                        <Rectangle Width="{Binding Percent}" HorizontalAlignment="Left" Fill="{DynamicResource Share.Fill}" />
                                    </Border>
                                    <TextBlock Grid.Column="5" Text="{Binding FilesText}" HorizontalAlignment="Right" Margin="4,0" />
                                </Grid>
                                <HierarchicalDataTemplate.Triggers>
                                    <!-- Let the selection color show through the name bar. -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Bar" Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInaccessible}" Value="True">
                                        <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Fg.Error}" />
                                        <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="FileIcon" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:TreeItemKind.Files}">
                                        <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="GroupText" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="FileIcon" Property="Source" Value="{x:Static local:FileIcons.GenericFile}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:TreeItemKind.File}">
                                        <!-- Only file rows look up their own icon. -->
                                        <Setter TargetName="FileIcon" Property="Source" Value="{Binding FullPath, Converter={StaticResource FileIcon}}" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </TabItem>

            <!-- Largest files -->
            <TabItem Header="{local:Tr TabLargestFiles}">
                <ListView x:Name="TopFilesList" BorderThickness="0" ItemsSource="{Binding TopFiles}" MouseDoubleClick="TopFiles_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{local:Tr ShowInExplorer}" Click="ShowFileInExplorer_Click" />
                            <MenuItem Header="{local:Tr CopyPath}" Click="CopyFilePath_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Rank}" />
                            <GridViewColumn Header="{local:Tr ColFile}" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding FullPath, Converter={StaticResource FileIcon}}" Width="16" Height="16"
                                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{local:Tr ColSize}" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Size, Converter={StaticResource Bytes}}" TextAlignment="Right" Width="84" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{local:Tr ColAllocated}"
                                            Width="{Binding ShowAllocatedColumn, Source={x:Static local:AppSettings.Current}, Converter={StaticResource ColumnWidth}, ConverterParameter=100}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AllocatedSize, Converter={StaticResource Bytes}}" TextAlignment="Right" Width="84" Foreground="{DynamicResource Fg.Muted}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{local:Tr ColFolder}" Width="500" DisplayMemberBinding="{Binding Folder}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <!-- Treemap -->
            <TabItem Header="{local:Tr TabTreemap}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                        <Button DockPanel.Dock="Left" Content="{local:Tr Up}" Padding="10,2" Command="{Binding TreemapUpCommand}" />
                        <TextBlock Text="{Binding TreemapTitle}" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="TreemapHover" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Fg.Muted}" />
                    <controls:TreemapControl x:Name="Treemap" Root="{Binding TreemapRoot}"
                                             Metric="{Binding SizeMetric, Source={x:Static local:AppSettings.Current}}" ContextMenu="{StaticResource FolderMenu}"
                                             NodeActivated="Treemap_NodeActivated" HoverChanged="Treemap_HoverChanged" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
