<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme colors. Light.xaml defines the same keys; ThemeManager swaps them at runtime. -->
    <SolidColorBrush x:Key="Bg.Window" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Bg.Panel" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Bg.Input" Color="#252525" />
    <SolidColorBrush x:Key="Bg.Control" Color="#333333" />
    <SolidColorBrush x:Key="Bg.ControlHover" Color="#3D3D3D" />
    <SolidColorBrush x:Key="Bg.ControlPressed" Color="#474747" />
    <SolidColorBrush x:Key="Bg.Popup" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Bg.Hover" Color="#2A2D2E" />
    <SolidColorBrush x:Key="Bg.Selection" Color="#264F78" />
    <SolidColorBrush x:Key="Bg.SelectionInactive" Color="#37373D" />
    <SolidColorBrush x:Key="Bg.TabSelected" Color="#1E1E1E" />

    <SolidColorBrush x:Key="Border.Control" Color="#4A4A4A" />
    <SolidColorBrush x:Key="Border.Subtle" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Accent" Color="#4CA0E0" />
    <SolidColorBrush x:Key="Fg.OnAccent" Color="#000000" />

    <SolidColorBrush x:Key="Fg.Text" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Fg.Muted" Color="#A0A0A0" />
    <SolidColorBrush x:Key="Fg.Header" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Fg.Disabled" Color="#6E6E6E" />
    <SolidColorBrush x:Key="Fg.Error" Color="#F07070" />

    <LinearGradientBrush x:Key="NameBar.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1F2A36" Offset="0" />
        <GradientStop Color="#2F4F73" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NameBar.Solid" Color="#2A3D52" />

    <SolidColorBrush x:Key="Share.Track" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Share.Border" Color="#5A6878" />
    <SolidColorBrush x:Key="Share.Fill" Color="#5B8FC7" />

    <SolidColorBrush x:Key="ScrollBar.Thumb" Color="#5A5A5A" />
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#7A7A7A" />

    <!-- Used by built-in templates, such as the corner between two scroll bars. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E1E1E" />
</ResourceDictionary>
